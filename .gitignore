# Virtual environment
.venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# Acquired upstream data -- reproduced by `python -m src.data.acquire`
# at the commit pinned in src/config.py, so it is never committed.
data/raw/

# Derived caches -- regenerated by the pipeline. The PLM embedding caches in
# particular are large and are a pure function of the sequences plus the
# pinned model versions.
data/cache/

# Model weights downloaded at runtime
*.pt

# Logs
logs/

# OS / editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/

# NOTE: data/processed/, results/ and models_store/ are deliberately NOT
# ignored. The curated datasets, split definitions, metric tables, figures and
# serialised models are the deliverables; committing them is what makes the
# reported numbers checkable without re-running the pipeline.
